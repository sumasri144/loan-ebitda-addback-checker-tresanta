# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Program output (run artifacts are regenerated, never committed)
out/

# Editor and OS clutter
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Test and coverage caches
.pytest_cache/
.coverage
htmlcov/

# Never commit credentials. The project needs no key to run its tests.
.env
.env.*
*.key
secrets.json
